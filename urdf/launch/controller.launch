<launch>

<rosparam file="$(find TWSBR_URDF_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="TWSBR_URDF" args="Revolute 1_position_controller Revolute 2_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/TWSBR_URDF/joint_states"/>
</node>

</launch>