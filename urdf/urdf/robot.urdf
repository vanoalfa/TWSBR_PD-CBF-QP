<?xml version='1.0' encoding='utf-8'?>
<robot name="ATERA_URDF">
  <!-- Dibuat dari ATERA_URDF.urdf.xacro (m_b = 2.225 kg, L = 0.100408 m, j_psi = 0.02337 kg.m^2). Lihat catatan ASUMSI di file xacro. Path mesh relatif: ../meshes/ -->
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0" />
