    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 1.570796 0" />
      <geometry>
        <mesh filename="../meshes/Lwheel_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="Rwheel_link">
    <inertial>
      <origin xyz="0.0 0.0 -0.036088" rpy="0 0 0" />
      <mass value="0.745" />
